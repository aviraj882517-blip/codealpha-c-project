#include <stdio.h>

int main() {
    double num1;
    double num2;
    char op;

    printf("Enter a number: ");
    scanf("%lf", &num1); 

    printf("Enter your operator: ");
    scanf(" %c", &op);

    printf("Enter a number: ");
    scanf("%lf", &num2);

    if (op == '+') {
        printf("%f\n", num1 + num2);
    } else if (op == '-') {
        printf("%f\n", num1 - num2);
    } else if (op == '*') {
        printf("%f\n", num1 * num2);
    } else if (op == '/') { 
        if (num2 != 0) {
            printf("%f\n", num1 / num2);
        } else {
            printf("Error: Division by zero\n");
        }
    } else {
        printf("Invalid operation\n");
    }

    return 0;
}
